# ── Secrets ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

# Phase B – LLM filter (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase C – Storage
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# Postgres (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jobs

# ── Phase B – Filter behaviour ─────────────────────────────────────────────
# Model used for the LLM semantic gate. Haiku is recommended (cheap, fast,
# sufficient for binary classification). Override for higher accuracy.
FILTER_MODEL=claude-haiku-4-5

# Max simultaneous Anthropic API calls in the filter layer.
LLM_CONCURRENCY=5

# Max characters of job description sent to the LLM (cost control).
MAX_DESCRIPTION_CHARS=3000

# ── Scraper behaviour ───────────────────────────────────────────────────────
# Max concurrent Playwright sessions. Raise carefully – more = faster but
# raises the risk of IP bans.
MAX_CONCURRENCY=3
