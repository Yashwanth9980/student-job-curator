# ── Secrets ────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

# Phase B – LLM filter (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Phase C – Storage
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# Postgres (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jobs

# ── Phase D – Scheduling ───────────────────────────────────────────────────
# How often the scheduler fires the pipeline (hours).
SCRAPE_INTERVAL_HOURS=6

# Run the pipeline once immediately when scheduler.py starts.
SCRAPE_ON_STARTUP=true

# ── Phase E – Staleness cleanup ────────────────────────────────────────────
# Jobs not seen in this many days are hard-deleted (likely closed roles).
STALE_DAYS=30

# ── Phase G – Discord notifications ────────────────────────────────────────
# Incoming webhook URL from your Discord channel settings.
# Leave blank to disable notifications.
DISCORD_WEBHOOK_URL=

# Max embed cards per Discord message (Discord hard-caps at 10).
DISCORD_MAX_EMBEDS=10

# ── Phase B – Filter behaviour ─────────────────────────────────────────────
# Model used for the LLM semantic gate. Haiku is recommended (cheap, fast,
# sufficient for binary classification). Override for higher accuracy.
FILTER_MODEL=gemini-2.0-flash

# Max simultaneous Gemini API calls in the filter layer.
LLM_CONCURRENCY=5

# Max characters of job description sent to the LLM (cost control).
MAX_DESCRIPTION_CHARS=3000

# ── Scraper behaviour ───────────────────────────────────────────────────────
# Max concurrent Playwright sessions. Raise carefully – more = faster but
# raises the risk of IP bans.
MAX_CONCURRENCY=3
